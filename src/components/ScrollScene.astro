<div class="orbital-scene"><div class="orbital-halo"></div><div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div><canvas id="geometry" role="img" aria-label="Sayfa kaydırıldıkça perspektifi değişen üç boyutlu matematiksel halka"></canvas><span class="orbit-mark mark-one">+</span><span class="orbit-mark mark-two">+</span><div class="scene-badge"><span></span> MATEMATİK × HAREKET</div></div>
<script>
const canvas=document.querySelector<HTMLCanvasElement>('#geometry')!;
const ctx=canvas.getContext('2d')!;
const reduce=matchMedia('(prefers-reduced-motion: reduce)');
const runway=document.querySelector<HTMLElement>('.hero-runway')!;
let width=0,height=0,target=0,current=0,frame=0;
function project(u:number,v:number,phase:number){const major=1.42;const minor=.49;let x=(major+minor*Math.cos(v))*Math.cos(u),y=(major+minor*Math.cos(v))*Math.sin(u),z=minor*Math.sin(v);const a=.55+phase*1.8,b=-.4+phase*.85;const y1=y*Math.cos(a)-z*Math.sin(a);const z1=y*Math.sin(a)+z*Math.cos(a);const x1=x*Math.cos(b)+z1*Math.sin(b);const z2=-x*Math.sin(b)+z1*Math.cos(b);const c=-.42+phase*.7;const xx=x1*Math.cos(c)-y1*Math.sin(c);const yy=x1*Math.sin(c)+y1*Math.cos(c);const scale=Math.min(width,height)*.245*(1+phase*.14);const perspective=4.7/(4.7-z2);return [width/2+xx*scale*perspective,height/2+yy*scale*perspective,z2];}
function draw(){ctx.clearRect(0,0,width,height);for(let j=0;j<34;j++){const v=j/34*Math.PI*2;ctx.beginPath();let depth=0;for(let i=0;i<=100;i++){const q=project(i/100*Math.PI*2,v,current);depth+=q[2];if(i===0)ctx.moveTo(q[0],q[1]);else ctx.lineTo(q[0],q[1]);}ctx.strokeStyle=`rgba(204,250,153,${.24+(depth/101+2)*.12})`;ctx.lineWidth=.65;ctx.stroke();}for(let j=0;j<22;j++){const u=j/22*Math.PI*2;ctx.beginPath();for(let i=0;i<=40;i++){const q=project(u,i/40*Math.PI*2,current);if(i===0)ctx.moveTo(q[0],q[1]);else ctx.lineTo(q[0],q[1]);}ctx.strokeStyle='rgba(138,178,104,.20)';ctx.lineWidth=.5;ctx.stroke();}for(const [u,v] of [[.8,1.4],[3.4,2],[5.2,.7]]){const q=project(u,v,current);ctx.beginPath();ctx.arc(q[0],q[1],2,0,Math.PI*2);ctx.fillStyle='#eaffcd';ctx.shadowColor='#c7fa72';ctx.shadowBlur=16;ctx.fill();ctx.shadowBlur=0;}}
function tick(){current=reduce.matches?0:current+(target-current)*.085;draw();if(Math.abs(target-current)>.0005&&!reduce.matches)frame=requestAnimationFrame(tick);else frame=0;}
function update(){const rect=runway.getBoundingClientRect();target=reduce.matches?0:Math.max(0,Math.min(1,-rect.top/Math.max(1,rect.height-innerHeight)));if(!frame)frame=requestAnimationFrame(tick);}
function resize(){const box=canvas.getBoundingClientRect();width=box.width;height=box.height;const dpr=Math.min(devicePixelRatio,2);canvas.width=width*dpr;canvas.height=height*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);update();}
new ResizeObserver(resize).observe(canvas);addEventListener('scroll',update,{passive:true});reduce.addEventListener('change',update);resize();
</script>
