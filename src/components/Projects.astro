---
const { limit } = Astro.props;
const modules = import.meta.glob('../pages/projeler/*.md', { eager: true });
const allProjects = Object.entries(modules)
  .map(([path, mod]) => ({ ...(mod as any).frontmatter, slug: path.split('/').pop()!.replace(/\.md$/, '') }))
  .sort((a,b) => (Number(a.order) || 99) - (Number(b.order) || 99));
const projects = typeof limit === 'number' && limit > 0 ? allProjects.slice(0, limit) : allProjects;
---
<div class="projects-grid">
  {projects.map((project) => (
    <a class:list={['project-card', { featured: Boolean(project.featured) }]} href={'/projeler/' + project.slug + '/'}>
      <div class="project-visual">
        {project.cover
          ? <img src={project.cover} alt={project.title + ' proje görseli'} loading="lazy" decoding="async" />
          : <div class="project-placeholder" aria-hidden="true"><strong>{project.title}</strong><span>{project.category}</span></div>
        }
      </div>
      <div class="project-details">
        <div class="project-topline"><span>{project.category}</span><span>{project.status}</span></div>
        <h3>{project.title} <span aria-hidden="true">↗</span></h3>
        <p>{project.description}</p>
        <span class="project-stack">{project.technologies}</span>
      </div>
    </a>
  ))}
</div>
