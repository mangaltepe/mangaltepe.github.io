---
import Base from './Base.astro';
const {frontmatter}=Astro.props;
const project=frontmatter.type==='project';
---
<Base title={frontmatter.title+' — Faruk'} description={frontmatter.description || frontmatter.title}><article class="prose"><a class="back" href={project?'/projeler/':'/blog/'}>← {project?'Tüm projeler':'Tüm yazılar'}</a><h1>{frontmatter.title}</h1><p class="mono">{frontmatter.category}{frontmatter.date ? ' / '+frontmatter.date : ''}</p><slot/></article></Base>