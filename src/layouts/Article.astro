---
import Base from './Base.astro';
import ContentMedia from '../components/ContentMedia.astro';
const { frontmatter } = Astro.props;
const category = String(frontmatter.category || 'Yazı');
const date = frontmatter.date ? String(frontmatter.date) : '';
---
<Base title={frontmatter.title + ' — Ahmet Faruk Mangaltepe'} description={frontmatter.description || frontmatter.title}>
  <article class="article-detail">
    <div class="article-header">
      <a class="back-link" href="/blog/">← Yazılara dön</a>
      <p class="article-meta">{category}{date && <span> · {date}</span>}</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="article-summary">{frontmatter.description}</p>}
    </div>
    {frontmatter.cover && <img class="article-cover" src={frontmatter.cover} alt={frontmatter.title + ' yazısının görseli'} loading="lazy" />}
    <div class="prose"><slot /></div>
    <ContentMedia title={frontmatter.title} gallery={frontmatter.gallery} video_url={frontmatter.video_url} video_caption={frontmatter.video_caption} />
    <div class="detail-bottom"><a class="back-link" href="/blog/">← Diğer yazılar</a></div>
  </article>
</Base>
