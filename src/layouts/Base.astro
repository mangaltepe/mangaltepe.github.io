---
const { title = 'Faruk — Yapay zekâ, matematik ve yazılım', description = 'Ahmet Faruk Mangaltepe. Yapay zekâ, matematik, yazılım ve oyun geliştirme üzerine projeler ve notlar.' } = Astro.props;
const path = Astro.url.pathname;
import '../styles/studio.css';
---
<!doctype html>
<html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f5f4ef"/><title>{title}</title><link rel="icon" href="/favicon.svg"/></head>
<body><div class="reading-progress" aria-hidden="true"></div><a class="skip" href="#main">İçeriğe geç</a>
<header><a class="brand" href="/" aria-label="Faruk ana sayfa"><span class="brand-symbol">fm.</span><span class="brand-word">FARUK<b> / STUDIO</b></span></a><nav aria-label="Ana menü"><a class:list={{active:path.startsWith('/projeler')}} href="/projeler/">Projeler</a><a class:list={{active:path.startsWith('/blog')}} href="/blog/">Yazılar</a><a class:list={{active:path.startsWith('/hakkimda')}} href="/hakkimda/">Hakkımda</a></nav><a class="header-action" href="https://github.com/mangaltepe" target="_blank" rel="noopener noreferrer">GitHub ↗</a></header>
<main id="main"><slot/></main>
<footer><a class="brand" href="/" aria-label="Ana sayfa"><span class="brand-symbol">fm.</span></a><span>Merak et. Deney yap. Üret.</span><span class="foot-right">© {new Date().getFullYear()} Ahmet Faruk Mangaltepe <a href="#main" aria-label="Başa dön">↑</a></span></footer>
</body></html>