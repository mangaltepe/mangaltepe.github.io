---
const { title = 'Faruk — Fikirden keşfe.', description = 'Matematik, kod ve aradaki fikirler. Ahmet Faruk Mangaltepe’nin kişisel alanı.' } = Astro.props;
const path = Astro.url.pathname;
import '../styles/global.css';
import '../styles/polish.css';
---
<!doctype html><html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#0b0d12"/><title>{title}</title><link rel="icon" href="/favicon.svg"/></head><body><div class="reading-progress" aria-hidden="true"></div><div class="ambient" aria-hidden="true"></div><a class="skip" href="#main">İçeriğe geç</a><header><a class="brand" href="/" aria-label="Faruk ana sayfa">f<span>.</span></a><nav aria-label="Ana menü"><a class:list={{active:path.startsWith('/projeler')}} href="/projeler/">Projeler</a><a class:list={{active:path.startsWith('/blog')}} href="/blog/">Yazılar</a><a class:list={{active:path.startsWith('/hakkimda')}} href="/hakkimda/">Hakkımda</a></nav><span class="header-note">KİŞİSEL ALAN <i></i></span></header><main id="main"><slot/></main><footer><a class="brand" href="/">f<span>.</span></a><span>Merak et. Üret. Paylaş.</span><span class="foot-right">© {new Date().getFullYear()} Ahmet Faruk Mangaltepe <a href="#main" aria-label="Başa dön">↑</a></span></footer></body></html>
