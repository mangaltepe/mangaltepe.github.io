---
import '../styles/studio.css';
import site from '../data/site.json';
const { title = 'Ahmet Faruk Mangaltepe — Projeler ve yazılar', description = 'Ahmet Faruk Mangaltepe: yapay zekâ araştırmaları, yazılım projeleri ve geliştirme notları.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Ahmet Faruk Mangaltepe — ana sayfa">
          <span class="brand-mark">fm.</span><span class="brand-name">Faruk Mangaltepe</span>
        </a>
        <nav aria-label="Ana menü">
          <a href="/projeler/" aria-current={path.startsWith('/projeler') ? 'page' : undefined}>Projeler</a>
          <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Yazılar</a>
          <a href="/hakkimda/" aria-current={path.startsWith('/hakkimda') ? 'page' : undefined}>Hakkımda</a>
        </nav>
        <a class="header-github" href={site.github_url} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <a class="footer-name" href="/">Ahmet Faruk Mangaltepe</a>
        <p>{site.footer_tagline}</p>
      </div>
      <div class="footer-links">
        <a href="/projeler/">Projeler</a><a href="/blog/">Yazılar</a><a href={site.github_url} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
      <span class="copyright">© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>
