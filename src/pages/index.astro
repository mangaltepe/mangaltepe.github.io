---
import Base from '../layouts/Base.astro';
import Projects from '../components/Projects.astro';
import Posts from '../components/Posts.astro';
import site from '../data/site.json';
---
<Base title="Ahmet Faruk Mangaltepe — Projeler, araştırmalar ve yazılar" description={site.hero_intro}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Ahmet Faruk Mangaltepe <span class="eyebrow-separator">·</span> Matematik & yazılım</p>
      <h1 id="hero-title">{site.hero_title}</h1>
      <p class="hero-description">{site.hero_intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projeler/">Projelerime bak <span aria-hidden="true">↗</span></a>
        <a class="button button-text" href="/hakkimda/">Hakkımda <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-context">Yıldız Teknik Üniversitesi · Matematik Bölümü</p>
    </div>
    <a class="hero-feature" href="/projeler/node/" aria-label="NODE projesini incele">
      <div class="hero-feature-image"><img src="/images/Node.jpg" alt="NODE projesinin görseli" fetchpriority="high" /></div>
      <div class="hero-feature-info"><div><span class="feature-kicker">Üzerinde çalıştığım proje</span><h2>NODE</h2><p>Yerel yapay zekâ modellerini kullanmayı kolaylaştıran bir çalışma alanı.</p></div><span class="feature-arrow" aria-hidden="true">↗</span></div>
    </a>
  </section>
  <section class="home-section" id="projeler" aria-labelledby="projects-title">
    <div class="section-heading"><div><span class="eyebrow">Seçili çalışmalar</span><h2 id="projects-title">Projeler</h2><p>Geliştirdiğim uygulamalar, modeller ve oyun prototipleri.</p></div><a class="section-link" href="/projeler/">Tüm projeler <span aria-hidden="true">↗</span></a></div>
    <Projects limit={3} />
  </section>
  <section class="home-section journal-section" id="yazilar" aria-labelledby="posts-title">
    <div class="section-heading"><div><span class="eyebrow">Geliştirme günlüğü</span><h2 id="posts-title">Son yazılar</h2><p>Deney sonuçları, teknik kararlar ve öğrendiklerim.</p></div><a class="section-link" href="/blog/">Yazı arşivi <span aria-hidden="true">↗</span></a></div>
    <Posts limit={3} />
  </section>
  <section class="home-about">
    <div><span class="eyebrow">Kısaca</span><h2>Ne üzerine çalışıyorum?</h2><p>Transformer mimarileri ve uyarlamalı hesaplama üzerine deneyler yürütüyor; yerel yapay zekâ araçları ve Unity prototipleri geliştiriyorum. Her projede nelerin çalıştığını ve nerede zorlandığımı paylaşmaya çalışıyorum.</p></div>
    <a class="section-link" href="/hakkimda/">Daha fazlası <span aria-hidden="true">↗</span></a>
  </section>
</Base>
