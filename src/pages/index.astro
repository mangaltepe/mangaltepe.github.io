---
import Base from '../layouts/Base.astro';import ScrollScene from '../components/ScrollScene.astro';import Projects from '../components/Projects.astro';import Posts from '../components/Posts.astro';
---
<Base><div class="home-experience"><div class="hero-runway" id="baslangic"><section class="hero"><div class="hero-coordinate" aria-hidden="true">PORTFOLIO / JOURNAL — 2026</div><div><div class="eyebrow">AHMET FARUK MANGALTEPE</div><h1>Fikirden<br/><span>keşfe.</span></h1><p class="intro">Matematik, kod ve aradaki olasılıklar.<br/>Öğrendiklerimi, ürettiklerimi ve merak ettiklerimi bir araya getirdiğim kişisel alanım.</p><div class="actions"><a class="btn" href="/projeler/">Projeleri keşfet <span>↗</span></a><a class="text-link" href="/blog/">Yazıları oku <span>→</span></a></div></div><div class="visual"><ScrollScene/><span class="visual-label">FIG. 001 — MERAKIN GEOMETRİSİ</span><span class="scene-coordinate" aria-hidden="true">x / y / ∞</span></div><a class="scroll-cue" href="#kesfet"><span class="scroll-line"></span>KEŞFETMEK İÇİN KAYDIR <span>↓</span></a></section></div><div class="ribbon" id="kesfet"><b>FİKİRLERİN KESİŞTİĞİ YER</b><span>MATEMATİK</span><span>YAPAY ZEKÂ</span><span>YAZILIM</span><span>↘ KEŞFETMEYE DEVAM</span></div><section class="section reveal" id="selected-projects"><div class="section-head"><h2><span class="section-no">01 /</span>Seçili projeler</h2><a href="/projeler/">Tüm projeler ↗</a></div><Projects/></section><section class="section reveal" id="latest-posts"><div class="section-head"><h2><span class="section-no">02 /</span>Düşünce defteri</h2><a href="/blog/">Tüm yazılar ↗</a></div><Posts/></section><section class="endnote reveal" id="son"><p>Her şey bir merakla başlar.</p><a href="/hakkimda/">Biraz da hakkımda ↗</a></section></div><nav class="section-rail" aria-label="Sayfa bölümleri"><a href="#baslangic" class="current" aria-label="Başlangıç"><span>Başlangıç</span></a><a href="#selected-projects" aria-label="Projeler"><span>Projeler</span></a><a href="#latest-posts" aria-label="Yazılar"><span>Yazılar</span></a></nav></Base>

<script>
const motion=matchMedia('(prefers-reduced-motion: reduce)');
const runway=document.querySelector<HTMLElement>('.hero-runway')!;
const root=document.documentElement;
const revealObserver=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target);}});},{threshold:.12});
document.querySelectorAll('.reveal,.project,.article-row').forEach(el=>{el.classList.add('will-reveal');revealObserver.observe(el);});
let queued=false;
function update(){queued=false;const max=document.documentElement.scrollHeight-innerHeight;const progress=max>0?scrollY/max:0;root.style.setProperty('--page-progress',String(progress));const rect=runway.getBoundingClientRect();const phase=Math.min(1,Math.max(0,-rect.top/Math.max(1,rect.height-innerHeight)));root.style.setProperty('--hero-phase',String(motion.matches?0:phase));root.style.setProperty('--ambient-hue',String(218+progress*40));const sections=['baslangic','selected-projects','latest-posts'];let active=sections[0];for(const id of sections){const el=document.getElementById(id);if(el&&el.getBoundingClientRect().top<innerHeight*.55)active=id;}document.querySelectorAll<HTMLAnchorElement>('.section-rail a').forEach(a=>{const selected=a.hash==='#'+active;a.classList.toggle('current',selected);if(selected)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}
addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(update);}},{passive:true});addEventListener('resize',update);motion.addEventListener('change',update);update();
if(matchMedia('(hover: hover) and (pointer: fine)').matches){document.querySelectorAll<HTMLElement>('.project-art').forEach(card=>{card.addEventListener('pointermove',event=>{if(motion.matches)return;const b=card.getBoundingClientRect();card.style.setProperty('--mx',`${(event.clientX-b.left)/b.width*100}%`);card.style.setProperty('--my',`${(event.clientY-b.top)/b.height*100}%`);});});}
</script>
