---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Hakkımda — Ahmet Faruk Mangaltepe" description={site.about_intro}>
  <section class="page-heading"><span class="eyebrow">Hakkımda</span><h1>{site.about_title}</h1><p>{site.about_intro}</p></section>
  <div class="about-layout">
    <div class="about-body">
      <p>{site.about_p1}</p><p>{site.about_p2}</p><p>{site.about_p3}</p>
      <div class="hero-actions"><a class="button button-primary" href="/projeler/">Çalışmalarımı incele <span aria-hidden="true">↗</span></a><a class="button button-text" href={site.github_url} target="_blank" rel="noopener noreferrer">GitHub profilim ↗</a></div>
    </div>
    <aside class="about-aside">
      <h2>Eğitim</h2><p>Yıldız Teknik Üniversitesi<br />Matematik Bölümü</p>
      <h2>İlgi alanlarım</h2><ul><li>Transformer mimarileri ve uyarlamalı hesaplama</li><li>Yerel yapay zekâ uygulamaları</li><li>AI ajanları ve araç entegrasyonları</li><li>Unity ile oyun prototipleri</li></ul>
    </aside>
  </div>
</Base>
